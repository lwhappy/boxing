{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "boxing-3",
  "compatibility_date": "2026-10-19",
  "observability": {
    "enabled": true
  },
  "workers_dev": true,
  "assets": {
    "directory": "web",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "silentjab.com",
      "custom_domain": true
    }
  ]
}
