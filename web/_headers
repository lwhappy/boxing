# Cloudflare Pages custom headers
# Docs: https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# three.js + addons: content-hashed, cache forever
/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# 3D models & audio: big files, cache 30 days (but always revalidate so a
# re-exported model is picked up; GLB URLs also carry a ?v= cache-buster)
/media/*
  Cache-Control: public, max-age=2592000, must-revalidate

# css/js: cache 7 days
/assets/*
  Cache-Control: public, max-age=604800

# --- HTML --------------------------------------------------------------
# Always revalidate HTML so a new deploy shows up immediately.
#
# Pages redirects /x.html -> /x and /dir/index.html -> /dir/, so the URL that
# actually gets served is the extension-less one. Header rules match the
# REQUEST path, so these have to target the served form.
#
# Only ONE splat is allowed per pattern, hence one rule per section instead
# of a single /*.html catch-all.
/  Cache-Control: public, max-age=0, must-revalidate

/moves/*
  Cache-Control: public, max-age=0, must-revalidate

/combos/*
  Cache-Control: public, max-age=0, must-revalidate

/training/*
  Cache-Control: public, max-age=0, must-revalidate

/404
  Cache-Control: public, max-age=0, must-revalidate

# AdSense root file: refresh hourly
/ads.txt
  Cache-Control: public, max-age=3600

/sitemap.xml
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600
