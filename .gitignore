# macOS
.DS_Store

# WorkBuddy workspace data
.workbuddy/
.workbuddy-ai/

# Heavy assets: 5.2 GB FBX animation library + 1.1 GB Blender sources
# (individual .blend files exceed GitHub's 100 MB limit; keep them local)
animations-black/
animations-red/
resources/
_archive/

# Fight page source assets (Blender sources + source GLB copies).
# Only the web-served copy in web/media/glb/ is tracked.
fight/blend/
fight/glb/
fight/*.glb
fight/*.html
fight/.DS_Store

# Local scratch demo (duplicates assets that live elsewhere)
web/demo/

# Source material for the combo pipeline (360 MB, incl. a 132 MB index.blend).
# Only the Python sources are tracked; the .blend/.fbx stay local.
motion-combine/*.blend
motion-combine/*.blend1
motion-combine/*.fbx
red-combine/

# Node
node_modules/

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
.env*
!.env.example
